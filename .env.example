# Modelo de variáveis de ambiente. Copie para .env e preencha.
# NUNCA versione o .env (só este .example). Nenhum segredo pode ter prefixo NEXT_PUBLIC_.

# --- Banco Neon ---
# No dashboard do Neon, copie a connection string. Você precisa das DUAS versões:
DATABASE_URL=            # POOLED (host com "-pooler") — usada pelo app
DATABASE_URL_UNPOOLED=   # DIRECT (host sem "-pooler") — usada por migrations/drizzle-kit

# URL base do app (links de e-mail). Em produção, a URL da Vercel.
APP_URL=http://localhost:3000

# --- Auth (Escopo 2) ---
RESEND_API_KEY=              # envio de e-mail (verificação/reset). Sem isso, em dev o link cai no console.
# UPSTASH_REDIS_REST_URL=    # (2b) rate limit contra força bruta
# UPSTASH_REDIS_REST_TOKEN=  # (2b) rate limit
